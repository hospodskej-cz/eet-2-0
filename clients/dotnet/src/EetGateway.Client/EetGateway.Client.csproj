<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <RootNamespace>EetGateway.Client</RootNamespace>

    <PackageId>EetGateway.Client</PackageId>
    <Version>0.1.1</Version>
    <Description>Typed .NET client for the EET Gateway HTTP API v1 (Czech EET 2.0). No dependencies beyond the BCL.</Description>
    <Authors>Hospodskej</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>eet;eet2;czech;fiscalization;pos</PackageTags>
    <RepositoryUrl>https://github.com/hospodskej-cz/eet-2-0</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
